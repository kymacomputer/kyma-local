#!/usr/bin/env python3
"""kyma -- runs from a clone with no install, no venv, no dependencies.

Python 3.9+ and nothing else. The whole point of this product is that the
first run costs nothing, so the entry point cannot start with "first create a
virtual environment".

Only the kyma package is loaded from src/, never src/ itself on sys.path: a
src/shlex.py or src/json.py dropped next to it would otherwise be imported in
place of the standard library, inside the hook, and answer for it.
"""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("kyma needs Python 3.9 or newer; this is %d.%d" % sys.version_info[:2])


def _load():
    from importlib.machinery import PathFinder
    src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "src")

    class KymaOnly:
        """Finds the top-level package `kyma` in src/, and nothing else there."""
        @staticmethod
        def find_spec(name, path=None, target=None):
            return PathFinder.find_spec(name, [src]) if name == "kyma" else None

    sys.meta_path.insert(0, KymaOnly)


_load()

if __name__ == "__main__":
    if sys.argv[1:] == ["hook"]:
        # the hook runs on every tool call: straight to it, without the CLI and argparse
        os.umask(0o077)
        from kyma.enforce import hook
        sys.exit(hook())
    from kyma.cli import main  # noqa: E402
    sys.exit(main())
